#!/bin/sh
set -e

# Only restore on genuine removal -- never on the upgrade-in-place that
# happens every time this package is reinstalled during development.
if [ "$1" != "remove" ]; then
    exit 0
fi

HELPER="/var/jb/usr/libexec/OITIRestoreGestalt"

if [ -x "$HELPER" ]; then
    if ! "$HELPER"; then
        echo "OITI: MobileGestalt restore failed; the Dynamic Island spoof may remain until repaired manually." >&2
    fi
else
    echo "OITI: restore helper is missing; the Dynamic Island spoof may remain until repaired manually." >&2
fi

exit 0
