<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>items</key>
    <array>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Island Notifications (Beta)</string>
        <key>footerText</key>
        <string>Beta. Shows incoming notifications as an element in the Dynamic Island, and hides the stock banner. If anything looks wrong, turn these off and the stock banners come back. Works only while the Island is on.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>islandNotificationsEnabled</string>
        <key>label</key>
        <string>Show Notifications in the Island</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>islandNotificationsHideBanner</string>
        <key>label</key>
        <string>Hide the Stock Banner</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Island Notification Style</string>
        <key>footerText</key>
        <string>Expanded shows the app icon, title and message. Wide and Compact are smaller pills. Takes effect on the next notification.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSLinkListCell</string>
        <key>detail</key>
        <string>PSListItemsController</string>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>IslandNotificationsStyle</string>
        <key>default</key>
        <integer>2</integer>
        <key>label</key>
        <string>Style</string>
        <key>validTitles</key>
        <array>
          <string>Compact</string>
          <string>Wide</string>
          <string>Expanded</string>
        </array>
        <key>validValues</key>
        <array>
          <integer>0</integer>
          <integer>1</integer>
          <integer>2</integer>
        </array>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Haptics</string>
        <key>footerText</key>
        <string>A short, light tap when a notification banner arrives. Works with or without Island Notifications. Follows the system's Haptics setting. Not played for notifications that go straight to the lock screen.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>NotificationHaptic</string>
        <key>label</key>
        <string>Notification Haptic</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Island Notification Duration</string>
        <key>footerText</key>
        <string>How many seconds each notification stays in the Island. Tap it to open the app, swipe up to dismiss.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>default</key>
        <real>4.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>IslandNotificationsDuration</string>
        <key>min</key>
        <real>2.0</real>
        <key>max</key>
        <real>10.0</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Island Notification Message Lines</string>
        <key>footerText</key>
        <string>How many lines of the message are shown before it is cut off with an ellipsis. The Island grows to fit.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>default</key>
        <real>2.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>IslandNotificationsMessageLines</string>
        <key>min</key>
        <real>1.0</real>
        <key>max</key>
        <real>4.0</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Island Notification Roundness</string>
        <key>footerText</key>
        <string>Adds to the Island's corner radius while a notification is showing. 0 is Apple's shape.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>default</key>
        <real>0.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>IslandNotificationsCornerExtra</string>
        <key>min</key>
        <real>-4.0</real>
        <key>max</key>
        <real>8.0</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>footerText</key>
        <string>Moves all incoming notification banners to below the Dynamic Island for better visibility.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>notificationFix</string>
        <key>label</key>
        <string>Fix Notification Positioning</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Custom Notification Positioning</string>
        <key>footerText</key>
        <string>Use custom positioning if you use a custom island position.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>notEnabled</string>
        <key>label</key>
        <string>Use Custom Notification Position</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSEditTextCell</string>
        <key>label</key>
        <string>X Position:</string>
        <key>prompt</key>
        <string>Enter X Position</string>
        <key>bestGuess</key>
        <string>0</string>
        <key>placeholder</key>
        <string>0</string>
        <key>isNumeric</key>
        <false/>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>xNot</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSEditTextCell</string>
        <key>label</key>
        <string>Y Position:</string>
        <key>prompt</key>
        <string>Enter Y Position</string>
        <key>bestGuess</key>
        <string>40</string>
        <key>placeholder</key>
        <string>40</string>
        <key>isNumeric</key>
        <false/>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>yNot</string>
      </dict>
      <dict>
        <key>action</key>
        <string>savePos</string>
        <key>cell</key>
        <string>PSButtonCell</string>
        <key>label</key>
        <string>Save</string>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
      </dict>
    </array>
    <key>title</key>
    <string>Notifications</string>
  </dict>
</plist>
