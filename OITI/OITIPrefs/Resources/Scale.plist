<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>items</key>
    <array>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Custom Island Scale</string>
        <key>footerText</key>
        <string>Scale the Island separately in width (X) and height (Y). The Island's contents are stretched with it, so extreme values distort icons and text. Setting a custom position is recommended for best results.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>scaleEnabled</string>
        <key>label</key>
        <string>Use Custom Scale</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Width (X)</string>
        <key>footerText</key>
        <string>1.0 is the stock width.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>default</key>
        <real>1.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>scaleX</string>
        <key>min</key>
        <real>0.5</real>
        <key>max</key>
        <real>2.0</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Height (Y)</string>
        <key>footerText</key>
        <string>1.0 is the stock height.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>default</key>
        <real>1.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>scaleY</string>
        <key>min</key>
        <real>0.5</real>
        <key>max</key>
        <real>2.0</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
      </dict>
      <dict>
        <key>action</key>
        <string>resetScale</string>
        <key>cell</key>
        <string>PSButtonCell</string>
        <key>label</key>
        <string>Reset Width and Height to 1.0</string>
      </dict>
    </array>
    <key>title</key>
    <string>Scale</string>
  </dict>
</plist>
