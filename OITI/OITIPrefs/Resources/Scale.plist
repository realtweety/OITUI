<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>items</key>
    <array>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Island Size</string>
        <key>footerText</key>
        <string>Makes the Island itself smaller or larger while icons, artwork and text keep their normal size. 1.0 is Apple's own size. Changes apply immediately, with no respring. Very small heights can clip tall content.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Island Width</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>default</key>
        <real>1.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>MetricsSensorWidthScale</string>
        <key>min</key>
        <real>0.4</real>
        <key>max</key>
        <real>1.5</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Island Height</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>default</key>
        <real>1.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>MetricsSensorHeightScale</string>
        <key>min</key>
        <real>0.7</real>
        <key>max</key>
        <real>1.5</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
      </dict>
      <dict>
        <key>action</key>
        <string>resetIslandSize</string>
        <key>cell</key>
        <string>PSButtonCell</string>
        <key>label</key>
        <string>Reset Island Size to 1.0</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Custom Island Scale</string>
        <key>footerText</key>
        <string>Scales the Island and everything in it together, separately in width (X) and height (Y). 1.0 is Apple's own size, so turning this on at 1.0 changes nothing. Contents are stretched with it, so extreme values distort icons and text. Setting a custom position is recommended. For a smaller Island with normal-size contents, use Island Size above instead.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>scaleEnabled</string>
        <key>label</key>
        <string>Use Custom Scale</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Width (X)</string>
        <key>footerText</key>
        <string>1.0 is the stock width.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>default</key>
        <real>1.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>RelativeScaleX</string>
        <key>min</key>
        <real>0.5</real>
        <key>max</key>
        <real>2.0</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Height (Y)</string>
        <key>footerText</key>
        <string>1.0 is the stock height.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSliderCell</string>
        <key>default</key>
        <real>1.0</real>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>RelativeScaleY</string>
        <key>min</key>
        <real>0.5</real>
        <key>max</key>
        <real>2.0</real>
        <key>showValue</key>
        <true/>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
      </dict>
      <dict>
        <key>action</key>
        <string>resetScale</string>
        <key>cell</key>
        <string>PSButtonCell</string>
        <key>label</key>
        <string>Reset Width and Height to 1.0</string>
      </dict>
    </array>
    <key>title</key>
    <string>Scale</string>
  </dict>
</plist>
