<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>items</key>
    <array>
      <dict>
        <key>cell</key>
        <string>PSGroupCell</string>
        <key>label</key>
        <string>Startup Animation Prototype</string>
        <key>footerText</key>
        <string>This experimental prototype runs after a respring or userspace reboot, once the phone is unlocked on the Home Screen. It plays the supplied Hello animation clip at most once every five minutes. The charging Island activity may be delayed until playback ends; calls and other Island activity can interrupt it. Off by default.</string>
      </dict>
      <dict>
        <key>cell</key>
        <string>PSSwitchCell</string>
        <key>default</key>
        <false/>
        <key>defaults</key>
        <string>com.wilburt.oiti.prefs</string>
        <key>key</key>
        <string>IslandStartupHelloEnabled</string>
        <key>label</key>
        <string>Enable Hello Animation (Prototype)</string>
        <key>PostNotification</key>
        <string>com.wilburt.oiti/PrefsChanged</string>
      </dict>
    </array>
  </dict>
</plist>
